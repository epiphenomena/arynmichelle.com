Options -Indexes
DirectoryIndex index.html index.php

# The playlist records under data/ are JSON. Nothing here is meant to be fetched
# directly, and <Directory> is not allowed in .htaccess, so deny by name.
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

# Retired entry points from the first version of this tool, when the admin lived
# here at the top level. publish_dtb never deletes, so a stale copy may still be
# sitting on the server -- and it would no longer be covered by any auth, since
# that now lives in admin/. Deny the old names outright. Nothing under admin/ is
# called admin.php or edit.php, so this cannot shadow a live file.
<FilesMatch "^(admin|edit)\.php$">
    Require all denied
</FilesMatch>

# Shared playlists are plain static pages at <token>/<playlist-name>/index.html,
# served by DirectoryIndex above. No rewriting, so this works in any subdirectory.
# They are unlisted rather than secret, so keep them out of search results.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set X-Robots-Tag "noindex, nofollow, noarchive"
    </FilesMatch>
</IfModule>
